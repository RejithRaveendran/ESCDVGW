# Copy to .env (never commit .env)

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty in development to use the embedded PGlite database.
DATABASE_URL=
# docker-compose only:
POSTGRES_PASSWORD=change-me
# PGSSL=true            # managed Postgres that requires TLS

# --- Security -------------------------------------------------------------
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=8h
TRUST_PROXY=false        # true when running behind a reverse proxy / load balancer

# --- First administrator (created on start if no admin exists) ------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Demo data (always on in development, opt-in in production) -----------
SEED_DEMO=false
DEMO_PASSWORD=EscDemo#2026

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=
MAX_UPLOAD_MB=25
PORT=4000
